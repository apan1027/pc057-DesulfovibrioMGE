Package: pc057
Title: Manuscript Analysis Records and Frozen Result Workflow for PC057
Version: 0.2.0
Authors@R: c(
    person("Jinlong", "Ru", , "jinlong.ru@helmholtz-munich.de", role = "aut",
           comment = c(ORCID = "0000-0002-6757-6018")),
    person("Cunli", "Pan", , "cunli.pan@tum.de", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-2595-7533"))
